# Rooh Experience Intelligence Environment Variables

# OpenAI API Key for structured AI extraction (Optional: fallback mock extractor used if not set)
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (Defaults to SQLite for local POC development)
DATABASE_URL=sqlite:///./rooh_experiences.db
# For PostgreSQL later:
# DATABASE_URL=postgresql://user:password@localhost:5432/rooh_db

# Backend Port
PORT=8000
